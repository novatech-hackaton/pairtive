# Copy to .env for local dev. Never commit .env.

# --- Public (bundled into the browser) ---
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase publishable (anon) key. Safe in the browser; RLS protects the data.
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# --- Server only (Vercel env vars; used by /api functions) ---
# Never prefix these with VITE_, or Vite will bundle them into the client.
SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase secret (service role) key. Bypasses RLS; server only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DAILY_API_KEY=your-daily-api-key

# --- Local tooling only (not needed on Vercel) ---
# Postgres connection string used by scripts/amMigrate.mjs.
# AM_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres
