{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "functions": {
    "api/amReportVerify.js": { "maxDuration": 60, "memory": 2048 },
    "api/amMatch.js": { "maxDuration": 15 },
    "api/amStartSession.js": { "maxDuration": 15 },
    "api/amSessionToken.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), display-capture=(self)" }
      ]
    }
  ]
}
